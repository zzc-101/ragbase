# ==============================================================================================
# ragbase 配置模板（由 `ragbase init` 复制为 .env；也可手动：cp .env.example .env）
#
# - 以 # 开头的行是注释；想改某项就去掉行首的 # 再改值。不写的项一律用括号里的默认值。
# - 这里只放占位符，请填你自己的值；.env 含密钥，已被 .gitignore 排除，不要提交、不要发给别人。
# - RAG_HOME（项目主目录，默认当前目录）必须是真正的环境变量，不能写在这个文件里。
# - 环境变量优先于 .env：同名变量在 shell / docker 里设置过，这里的值不生效。
# ==============================================================================================

# ---------------------------------------------------------------------------------------------
# 1. 大模型（回答与对话 Agent 必填；不配也能检索 /search）
#    走 OpenAI 兼容协议：OpenAI、DeepSeek、通义千问、火山方舟、Moonshot、本地 vLLM / Ollama 等都可以，
#    只要把下面三项换成该服务商给你的地址、密钥、模型名。
#    （旧的 ARK_BASE_URL / ARK_CHAT_API_KEY / ARK_CHAT_MODEL 仍然有效，RAG_LLM_* 优先）
# ---------------------------------------------------------------------------------------------
# RAG_LLM_BASE_URL=https://api.openai.com/v1
# RAG_LLM_API_KEY=sk-请替换为你的密钥
# RAG_LLM_MODEL=gpt-4o-mini
#
# 其它示例（任选其一替换上面三项）：
#   DeepSeek：  https://api.deepseek.com/v1            模型 deepseek-chat
#   火山方舟：  https://ark.cn-beijing.volces.com/api/v3   模型填推理接入点 ID（ep-xxxx）
#   本地 Ollama：http://localhost:11434/v1              密钥随便填一个非空值，模型如 qwen2.5:7b

# RAG_LLM_PROTOCOL=openai            # 目前只支持 openai（OpenAI 兼容）
# RAG_LLM_TEMPERATURE=0              # 0~2；问答建议 0
# RAG_LLM_MAX_TOKENS=                # 留空 = 不限制，用服务端默认
# RAG_LLM_TIMEOUT=60                 # 单次请求超时（秒）
# RAG_LLM_MAX_RETRIES=2              # 超时 / 连接错误 / 429 / 5xx 的自动重试次数

# 评测裁判（ragbase eval）可单独指定模型；留空则沿用上面的回答模型
# RAG_EVAL_LLM_BASE_URL=
# RAG_EVAL_LLM_API_KEY=
# RAG_EVAL_LLM_MODEL=

# ---------------------------------------------------------------------------------------------
# 2. 接口鉴权与服务地址
#    服务对外暴露（Docker、局域网、公网）时务必设置 RAG_API_KEY，否则任何人都能用你的知识库和大模型额度。
#    生成一把随机密钥：  ragbase init --api-key   （新建 .env 时自动写入）
#                  或：  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#                  或：  openssl rand -hex 32
#    Web 界面会弹窗要求输入这把密钥；API 请求带 Authorization: Bearer <密钥> 或 X-API-Key。
# ---------------------------------------------------------------------------------------------
# RAG_API_KEY=
# RAG_HOST=127.0.0.1                 # 监听地址；0.0.0.0 = 对外开放（务必同时设置 RAG_API_KEY）
# RAG_PORT=8000
# RAG_CORS_ORIGINS=                  # 前端部署在别的域名时填，逗号分隔，如 https://app.example.com
# RAG_MAX_UPLOAD_MB=300              # POST /documents 单文件大小上限
# RAG_LOG_LEVEL=INFO                 # DEBUG / INFO / WARNING / ERROR / CRITICAL

# ---------------------------------------------------------------------------------------------
# 3. embedding 与 reranker：本地模型 或 云端 API（没有 GPU 的机器建议用云端，更快）
#
#    提供方          本地（默认）                       云端
#    embedding      RAG_EMBEDDING_PROVIDER=local       RAG_EMBEDDING_PROVIDER=openai（OpenAI 兼容 POST {地址}/embeddings）
#    reranker       RAG_RERANKER_PROVIDER=local        RAG_RERANKER_PROVIDER=api（POST {地址}/rerank）或 none（不精排）
#
#    ！换 embedding（提供方 / 模型 / 维度）会让旧向量失效：必须 `ragbase ingest --full` 重建索引；
#      不重建的话 serve / ask / chat / 增量 ingest 会拒绝启动（索引旁的 .index_info.json 记录了建索引时的 embedding）。
#    ！换 reranker（模型或服务商）后得分分布不同：用 scripts/calibrate_rerank_threshold.py 重新标定 RAG_MIN_SCORE
#      （第 4 节）；reranker=none 时没有得分，不会按相关度拒答，只有召回为空才拒答。
#    云端提供方不需要下载模型；embedding 与 reranker 都用云端时，ragbase 命令行启动也不再加载 torch。
# ---------------------------------------------------------------------------------------------
# RAG_EMBEDDING_PROVIDER=local       # local / openai
# RAG_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B   # 本地：Hugging Face 仓库名；云端：服务商的模型 ID（如 BAAI/bge-m3）
# RAG_RERANKER_PROVIDER=local        # local / api / none
# RAG_RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B     # 本地：Hugging Face 仓库名；云端：服务商的模型 ID（如 BAAI/bge-reranker-v2-m3）
# RAG_DEVICE=auto                    # 仅本地模型：auto（mps > cuda > cpu）/ mps / cuda / cpu。纯 CPU 能用，但精排较慢

# --- 云端 embedding（RAG_EMBEDDING_PROVIDER=openai 时）
# 地址 / 密钥留空则回退到第 1 节的 RAG_LLM_BASE_URL / RAG_LLM_API_KEY（同一家服务商同时提供大模型和 embedding 时不用重复填）。
# 安全起见：只有最终地址与 RAG_LLM_BASE_URL 是同一个服务（协议 + 主机 + 端口相同）时才会沿用大模型的密钥，
# 单独指定了别家地址就必须单独填 RAG_EMBEDDING_API_KEY。本机 Ollama / vLLM 之类不校验密钥的服务可以不填。
# RAG_EMBEDDING_BASE_URL=            # 如 https://api.siliconflow.cn/v1（会请求 {地址}/embeddings）
# RAG_EMBEDDING_API_KEY=
# RAG_EMBEDDING_DIMENSIONS=          # 可选：作为 dimensions 参数发给服务端（仅支持缩减维度的模型）；也计入索引签名
# RAG_EMBEDDING_BATCH_SIZE=16        # 每次请求最多发多少条文本；部分服务商有上限（如 DashScope 兼容模式文档标注为 10），请以服务商文档为准
# RAG_EMBEDDING_QUERY_INSTRUCTION=   # 可选：只加在“查询”前面的指令前缀，文档不加。Qwen3-Embedding 这类模型建议填，
#                                    #   如 Instruct: Given a web search query, retrieve relevant passages\nQuery: （\n 会还原成换行）；bge-m3 等留空
# RAG_EMBEDDING_TIMEOUT=             # 单次请求超时（秒），留空沿用 RAG_LLM_TIMEOUT
# RAG_EMBEDDING_MAX_RETRIES=         # 超时 / 连接错误 / 429 / 5xx 的重试次数，留空沿用 RAG_LLM_MAX_RETRIES

# --- 云端 rerank（RAG_RERANKER_PROVIDER=api 时）：POST {地址}/rerank，请求 {model, query, documents, top_n}，
#     响应 {results: [{index, relevance_score}]}（Jina、SiliconFlow、Cohere v2 兼容网关、Xinference、vLLM 等的通用形状）
# RAG_RERANKER_BASE_URL=             # 如 https://api.siliconflow.cn/v1（会请求 {地址}/rerank）；留空回退 RAG_LLM_BASE_URL
# RAG_RERANKER_API_KEY=              # 留空时回退规则同 embedding
# RAG_RERANKER_TIMEOUT=
# RAG_RERANKER_MAX_RETRIES=

# --- 完整示例（以下地址 / 模型名只是示例，未逐一验证，请以服务商文档为准；复制到上面对应项即可）
#   全云端 · SiliconFlow 风格（同一密钥同时用于 embedding 和 rerank）：
#     RAG_EMBEDDING_PROVIDER=openai
#     RAG_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
#     RAG_EMBEDDING_API_KEY=请替换为你的密钥
#     RAG_EMBEDDING_MODEL=BAAI/bge-m3
#     RAG_RERANKER_PROVIDER=api
#     RAG_RERANKER_BASE_URL=https://api.siliconflow.cn/v1
#     RAG_RERANKER_API_KEY=请替换为你的密钥
#     RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
#     # 换 reranker 后务必用 scripts/calibrate_rerank_threshold.py 重新标定 RAG_MIN_SCORE（默认 0.7 只适用于默认本地 reranker）
#   阿里云百炼 DashScope 兼容模式（embedding；rerank 可继续用本地或另一家）：
#     RAG_EMBEDDING_PROVIDER=openai
#     RAG_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#     RAG_EMBEDDING_API_KEY=请替换为你的密钥
#     RAG_EMBEDDING_MODEL=text-embedding-v3
#     RAG_EMBEDDING_BATCH_SIZE=10
#   本机 Ollama（embedding；Ollama 的 OpenAI 兼容接口，密钥可不填）：
#     RAG_EMBEDDING_PROVIDER=openai
#     RAG_EMBEDDING_BASE_URL=http://localhost:11434/v1
#     RAG_EMBEDDING_MODEL=bge-m3
#   不精排（最省事，但没有相关度拒答）：RAG_RERANKER_PROVIDER=none

# 模型下载（ragbase models download，只下载本地的那个）：国内网络访问 Hugging Face 慢或不通时启用镜像
# HF_ENDPOINT=https://hf-mirror.com
# HF_HOME=                           # 模型缓存根目录，默认 ~/.cache/huggingface

# ---------------------------------------------------------------------------------------------
# 4. 检索与拒答
# ---------------------------------------------------------------------------------------------
# RAG_MODE=hybrid                    # 默认召回方式：vector / bm25 / hybrid
# RAG_RETRIEVE_K=20                  # 精排前的候选数
# RAG_PER_ROUTE_K=30                 # 混合检索每一路各取多少
# RAG_RERANK_K=5                     # 精排后保留的片段数
# RAG_MIN_SCORE=0.7                  # 最相关片段精排得分低于它就拒答、不调用大模型；0 = 不拒答。0.7 是按默认本地 reranker 标定的，换 reranker 要重新标定
# RAG_CONTEXT_MIN_SCORE=0.95         # 只把得分不低于它的片段交给大模型（top1 总保留）；0 = 不过滤

# ---------------------------------------------------------------------------------------------
# 5. 向量库
#    默认 Chroma（本地目录，零配置）。也可用 Qdrant：嵌入式目录，或连接 Qdrant 服务端（docker compose --profile qdrant）。
#    切换后端用 `ragbase migrate-store --to qdrant` 迁移已有索引，不用重新向量化。
# ---------------------------------------------------------------------------------------------
# RAG_VECTOR_STORE=chroma            # chroma / qdrant
# RAG_COLLECTION=rag
# RAG_QDRANT_URL=                    # 如 http://localhost:6333（Docker Compose 里是 http://qdrant:6333）；留空 = 用本地目录 RAG_QDRANT_PATH
# RAG_QDRANT_API_KEY=                # Qdrant 服务端的密钥（可选）
# RAG_QDRANT_PATH=                   # 默认 <主目录>/qdrant_db
CHROMA_TELEMETRY_DISABLED=true

# ---------------------------------------------------------------------------------------------
# 6. 路径（默认全部在项目主目录 RAG_HOME 下，一般不用改；相对路径不会被自动解析，请写绝对路径）
# ---------------------------------------------------------------------------------------------
# RAG_DATA_DIR=                      # 文档目录，默认 <主目录>/data
# RAG_DB_DIR=                        # Chroma 数据目录，默认 <主目录>/chroma_db
# RAG_META_FILE=                     # 增量入库的文件指纹，默认 <主目录>/.ingest_meta.json
# RAG_INDEX_INFO_FILE=               # 索引的 embedding 签名（提供方 / 模型 / 维度），默认与 RAG_META_FILE 同目录的 .index_info.json
# RAG_CACHE_DIR=                     # BM25 分词缓存，默认 <主目录>/.bm25_cache
# RAG_WEB_DIST=                      # 前端构建产物，默认 <主目录>/web/dist，没有则用随包的副本

# ---------------------------------------------------------------------------------------------
# 7. 对话 Agent（POST /chat；会话只存在进程内存里，重启即丢）
# ---------------------------------------------------------------------------------------------
# RAG_AGENT_MAX_TOOL_CALLS=4         # 每轮用户消息最多调用几次检索工具
# RAG_AGENT_MAX_MODEL_CALLS=6        # 每轮用户消息最多调用几次大模型
# RAG_CHAT_HISTORY_TURNS=10          # 每个会话保留最近几轮
# RAG_CHAT_MAX_SESSIONS=200          # 内存中最多保留的会话数
# RAG_CHAT_SESSION_TTL=3600          # 会话空闲多少秒后过期
